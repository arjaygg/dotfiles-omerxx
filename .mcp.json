{
  "mcpServers": {
    "pctx": {
      "command": "bash",
      "args": [
        "-c",
        "exec \"$HOME/.dotfiles/.local/bin/pctx_wrapper.sh\" mcp start --stdio -c \"$HOME/.config/pctx/pctx.json\""
      ],
      "env": {}
    },
    "lean-ctx": {
      "command": "bash",
      "args": [
        "-c",
        "exec \"$HOME/.dotfiles/.local/bin/lean_ctx_wrapper.sh\" mcp --stdio"
      ],
      "env": {
        "LEAN_CTX_CACHE_TTL": "300",
        "RUST_LOG": "error"
      }
    }
  }
}
