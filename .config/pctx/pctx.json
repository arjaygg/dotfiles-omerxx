{
  "name": "${env:USER}",
  "version": "0.1.0",
  "disclosure": "catalog",
  "servers": [
    {
      "name": "serena",
      "command": "bash",
      "args": [
        "-c",
        "export PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:$HOME/homebrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; exec \"$HOME/.dotfiles/.local/bin/serena_wrapper.sh\" \"$@\"",
        "pctx-serena",
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--log-level",
        "ERROR"
      ]
    },
    {
      "name": "qmd",
      "command": "bash",
      "args": [
        "-c",
        "export PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:$HOME/homebrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; exec qmd \"$@\"",
        "pctx-qmd",
        "mcp"
      ]
    },
    {
      "name": "lean-ctx",
      "command": "bash",
      "args": [
        "-c",
        "export PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:$HOME/homebrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; exec \"$HOME/.dotfiles/.local/bin/lean_ctx_wrapper.sh\" mcp --stdio"
      ],
      "env": {
        "LEAN_CTX_CACHE_TTL": "300"
      }
    },
    {
      "name": "repomix",
      "command": "bash",
      "args": [
        "-c",
        "export PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:$HOME/homebrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; exec repomix \"$@\"",
        "pctx-repomix",
        "--mcp"
      ]
    },
    {
      "name": "graphify",
      "command": "bash",
      "args": [
        "-c",
        "exec \"$HOME/.dotfiles/.local/bin/graphify-mcp-conditional\" \"$@\"",
        "pctx-graphify"
      ]
    }
  ],
  "logger": {
    "enabled": false,
    "level": "error",
    "format": "compact",
    "colors": true
  },
  "telemetry": {
    "traces": {
      "enabled": false,
      "sampling": {
        "strategy": "always",
        "rate": 1.0
      },
      "exporters": []
    },
    "metrics": {
      "enabled": false,
      "exporters": []
    }
  }
}
