# AI Engineering Coach — upstream content (synced via ai/skills/coach/sync.sh)
ai/skills/coach/rules/
ai/skills/coach/coach-persona.ts

# Local configurations (do not commit secrets or machine-specific paths)
.config/
!.config/pctx/
.config/dotfiles-ai/
.claude/settings.local.json
# Runtime-managed projection, generated from ai/config/claude/settings.base.json
# (decisions/0016) — the lean-ctx daemon and Claude Code rewrite it with
# machine-local paths/state, so it is untracked.
.claude/settings.json
.mcp.json
.mcp.local.json

# Local tooling state (may contain tokens/pids)
.osgrep/


# Machine-local secrets (never commit API keys)
*.secret.nu

# Serena runtime state (logs, cache, acted-run tracking)
.serena/logs/
.serena/cache/
.serena/memories/cicd-acted-runs.md

# Backup files (never commit editor/script .bak artifacts)
*.bak

# TypeScript hook scaffolding (infrastructure for writing TS hooks; actual hooks live in bash)
.claude/hooks/ts/

# Accidental/self-referential stow symlinks
.claude/commands/commands
.claude/output-styles/output-styles
**/__pycache__/

# generated data (graphify graph output, token telemetry, hook logs)
graphify-out/
tokentelemetry/
.claude/hooks/.logs/

# git-pipeline-gate audit log (append-only, machine-local; plans/2026-07-25-agentic-git-pipeline.md)
.claude/pipeline-log.jsonl

# TDD-Guard local test-run state (machine-local, regenerated per pytest run)
.claude/tdd-guard/

# pre-compact.sh generated resume snapshot (regenerated every compaction)
plans/session-snapshot.md

# personal skill customization overrides (see ai/skills/README.md)
.claude/custom/*.user.toml
