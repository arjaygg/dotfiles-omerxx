{
  "mcpServers": {
    "serena": {
      "command": "bash",
      "args": [
        "-c",
        "export PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:$HOME/homebrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; exec \"$HOME/.dotfiles/.local/bin/serena_wrapper.sh\" \"$@\"",
        "serena",
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--log-level",
        "ERROR"
      ]
    },
    "pctx": {
      "command": "bash",
      "args": [
        "-c",
        "exec pctx mcp start -q --stdio -c \"$HOME/.config/pctx/pctx.json\""
      ]
    }
  }
}