{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "mcp": {
    "lean-ctx": {
      "command": [
        "bash",
        "-c",
        "exec \"$HOME/.cargo/bin/lean-ctx\""
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "opencode/kimi-k2.5",
  "permission": {
    "bash": "deny",
    "glob": "deny",
    "grep": "deny",
    "read": "deny"
  }
}