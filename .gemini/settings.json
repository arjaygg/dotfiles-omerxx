{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "experimental": {
    "enableAgents": true
  },
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/lean-ctx hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/lean-ctx hook rewrite",
            "type": "command"
          }
        ],
        "matcher": "shell|execute_command|run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "$HOME/.local/bin/lean-ctx hook deny",
            "type": "command"
          }
        ],
        "matcher": "read_file|read_many_files|grep|search|list_dir|glob|list_files"
      }
    ]
  },
  "mcpServers": {
    "serena": {
      "args": [
        "-c",
        "export PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:$HOME/homebrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; exec \"$HOME/.dotfiles/.local/bin/serena_wrapper.sh\" \"$@\"",
        "serena",
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--log-level",
        "ERROR"
      ],
      "command": "bash"
    },
    "pctx": {
      "args": [
        "-c",
        "exec pctx mcp start --stdio -c \"$HOME/.config/pctx/pctx.json\""
      ],
      "command": "bash"
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "selectedAuthType": "oauth-personal"
}