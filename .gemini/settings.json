{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "experimental": {
    "enableAgents": true
  },
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "/Users/agallentes/.local/bin/lean-ctx hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "/Users/agallentes/.local/bin/lean-ctx hook rewrite",
            "type": "command"
          }
        ],
        "matcher": "shell|execute_command|run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "/Users/agallentes/.local/bin/lean-ctx hook deny",
            "type": "command"
          }
        ],
        "matcher": "read_file|read_many_files|grep|search|list_dir|glob|list_files"
      }
    ]
  },
  "mcpServers": {
    "lean-ctx": {
      "args": [
        "-c",
        "exec \"$HOME/.dotfiles/.local/bin/lean_ctx_wrapper.sh\" mcp --stdio"
      ],
      "command": "bash",
      "env": {
        "LEAN_CTX_CACHE_TTL": "300",
        "RUST_LOG": "error"
      }
    },
    "pctx": {
      "args": [
        "-c",
        "exec pctx mcp start --stdio -c \"$HOME/.config/pctx/pctx.json\""
      ],
      "command": "bash"
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "selectedAuthType": "oauth-personal"
}