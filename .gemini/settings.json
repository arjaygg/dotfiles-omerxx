{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "experimental": {
    "enableAgents": true
  },
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "/Users/agallentes/.local/bin/lean-ctx hook observe",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "/Users/agallentes/.local/bin/lean-ctx hook rewrite",
            "type": "command"
          }
        ],
        "matcher": "shell|execute_command|run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "/Users/agallentes/.local/bin/lean-ctx hook redirect",
            "type": "command"
          }
        ],
        "matcher": "read_file|read_many_files|grep|search|list_dir|glob|list_files"
      }
    ]
  },
  "mcpServers": {
    "pctx": {
      "args": [
        "mcp",
        "start",
        "-q",
        "--stdio",
        "-c",
        "/Users/agallentes/.config/pctx/pctx.json"
      ],
      "command": "pctx"
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "selectedAuthType": "oauth-personal"
}