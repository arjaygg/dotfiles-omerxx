{
  "context-file-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.gemini/hooks/context-file-gate.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "context-observe": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.gemini/hooks/context-observe.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "git-commit-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.gemini/hooks/git-commit-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "pr-title-conventional-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.gemini/hooks/pr-title-conventional-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "pre-push-remote-check": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.gemini/hooks/pre-push-remote-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
