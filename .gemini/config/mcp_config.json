{
  "mcpServers": {
    "pctx": {
      "command": "bash",
      "args": [
        "-c",
        "exec pctx mcp start --stdio -c \"$HOME/.config/pctx/pctx.json\""
      ]
    },
    "lean-ctx": {
      "command": "bash",
      "args": [
        "-c",
        "exec \"$HOME/.dotfiles/.local/bin/lean_ctx_wrapper.sh\" mcp --stdio"
      ],
      "env": {
        "LEAN_CTX_CACHE_TTL": "300",
        "RUST_LOG": "error"
      }
    },
    "notebooklm": {
      "command": "notebooklm-mcp",
      "args": []
    },
    "chrome-devtools": {
      "command": "chrome-devtools-mcp-wrapper.sh",
      "args": []
    }
  }
}
