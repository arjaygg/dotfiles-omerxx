{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "serena": {
      "command": "serena_wrapper.sh",
      "args": [
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--log-level",
        "ERROR"
      ]
    },
    "repomix": {
      "command": "repomix",
      "args": [
        "--mcp"
      ]
    },
    "graphify": {
      "command": "graphify-mcp-conditional",
      "args": []
    },
    "lean-ctx": {
      "command": "lean-ctx",
      "env": {
        "LEAN_CTX_DATA_DIR": "${LEAN_CTX_DATA_DIR}",
        "LEAN_CTX_FULL_TOOLS": "1"
      }
    }
  }
}
