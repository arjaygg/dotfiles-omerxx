{
  "$schema": "https://json.schemastore.org/gemini-cli-settings.json",
  "mcpServers": {
    "serena": {
      "command": "serena_wrapper.sh",
      "args": [
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--log-level",
        "ERROR"
      ]
    },
    "repomix": {
      "command": "repomix",
      "args": [
        "--mcp"
      ]
    },
    "graphify": {
      "command": "graphify-mcp-conditional",
      "args": []
    },
    "lean-ctx": {
      "command": "bash",
      "args": [
        "-c",
        "exec \"$HOME/.dotfiles/.local/bin/lean_ctx_wrapper.sh\" mcp --stdio"
      ],
      "env": {
        "LEAN_CTX_CACHE_TTL": "300",
        "RUST_LOG": "error"
      }
    }
  }
}
