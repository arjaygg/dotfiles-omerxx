      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -fd*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(kill -9 *)",
      "Bash(find * -delete*)",
      "Bash(find *)",
      "Bash(shred *)",
      "Bash(dd if=*)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Read(~/.ssh/*)",
      "Edit(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Edit(~/.aws/*)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(grep -*)",
      "Read(**/package-lock.json)",
