    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|EnterWorktree|ExitWorktree|mcp__pctx__execute_typescript",
        "hooks": [
          {
            "type": "command",
            "command": "dispatcher=\"$HOME/.dotfiles/.claude/hooks/lifecycle-pretool.sh\"; output=''; dispatcher_rc=126; if [ -f \"$dispatcher\" ] && [ -r \"$dispatcher\" ]; then output=\"$(/bin/bash \"$dispatcher\" 2>/dev/null)\"; dispatcher_rc=$?; fi; validated=\"$(printf '%s' \"$output\" | LIFECYCLE_DISPATCH_RC=\"$dispatcher_rc\" /usr/bin/python3 -c 'import json, os, re, sys\ndef bad():\n    raise SystemExit(2)\nif os.environ.get(\"LIFECYCLE_DISPATCH_RC\") != \"0\":\n    bad()\nraw = sys.stdin.buffer.read(65537)\nif not raw or len(raw) > 65536:\n    bad()\ndef unique(pairs):\n    value = {}\n    for key, item in pairs:\n        if key in value:\n            bad()\n        value[key] = item\n    return value\ntry:\n    value = json.loads(raw, object_pairs_hook=unique, parse_constant=lambda _: bad())\nexcept (UnicodeError, json.JSONDecodeError):\n    bad()\nif type(value) is not dict:\n    bad()\nenvelope = value.get(\"lifecycle_hook\")\nif type(envelope) is not dict:\n    bad()\nbinding = envelope.get(\"binding\")\nkeys = {\"schema_version\", \"processed\", \"event\", \"binding\"} | ({\"run_id\"} if binding == \"bound\" else set())\nif (set(envelope) != keys or type(envelope.get(\"schema_version\")) is not int or envelope.get(\"schema_version\") != 1 or envelope.get(\"processed\") is not True or envelope.get(\"event\") != \"PreToolUse\" or binding not in {\"bound\", \"unbound\"}):\n    bad()\nif binding == \"bound\":\n    run_id = envelope.get(\"run_id\")\n    if type(run_id) is not str or re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9._-]{0,127}\", run_id) is None:\n        bad()\nif set(value) == {\"lifecycle_hook\"}:\n    pass\nelif set(value) == {\"lifecycle_hook\", \"hookSpecificOutput\"}:\n    native = value.get(\"hookSpecificOutput\")\n    reason = native.get(\"permissionDecisionReason\") if type(native) is dict else None\n    if (type(native) is not dict or set(native) != {\"hookEventName\", \"permissionDecision\", \"permissionDecisionReason\"} or native.get(\"hookEventName\") != \"PreToolUse\" or native.get(\"permissionDecision\") != \"deny\" or type(reason) is not str or not reason.startswith(\"[HARD-BLOCK\") or len(reason) > 4096):\n        bad()\nelse:\n    bad()\nprint(json.dumps(value, ensure_ascii=False, separators=(\",\", \":\")))' 2>/dev/null)\"; validator_rc=$?; if [ \"$validator_rc\" -eq 0 ] && [ -n \"$validated\" ]; then printf '%s\\n' \"$validated\"; else printf '%s\\n' '{\"lifecycle_hook\":{\"schema_version\":1,\"processed\":true,\"event\":\"PreToolUse\",\"binding\":\"bound\",\"run_id\":\"outer-fail-closed\"},\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"[HARD-BLOCK — DO NOT RETRY] Lifecycle PreToolUse dispatcher output failed independent settings validation; failed closed.\"}}'; fi; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep|Glob|Agent|Workflow",
        "hooks": [
