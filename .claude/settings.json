{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "alwaysThinkingEnabled": true,
  "autoCompact": true,
  "autoMemory": false,
  "compactCustomInstructions": "After compaction, immediately re-read plans/session-snapshot.md first if it exists \u2014 it is generated fresh from the live transcript and git state at the moment of compaction, so it is more trustworthy than hand-edited files. Fall back to plans/active-context.md only if session-snapshot.md is absent, and treat active-context.md with suspicion if its content conflicts with session-snapshot.md or the verified conversation history \u2014 it can carry over stale content from an earlier or unrelated task. Do not waste summary tokens on content already captured in plans/ files (active-context.md, decisions.md, progress.md) \u2014 those files persist on disk and will be re-read. Focus the summary on: in-flight tool call results not yet written to disk, ephemeral error messages, and any decisions made verbally that have not been recorded. Always preserve: current branch name, uncommitted file list, active plan file path, and the exact task being worked on at the moment of compaction. Do not re-Read CLAUDE.md, AGENTS.md, or any file they @-import (rules/*.md) after compaction \u2014 their content is reloaded automatically as part of the system prompt and a manual re-read wastes tokens on content already in context. Never copy hook advisory text into the summary \u2014 exclude [SESSION INIT ...] banners, MANDATORY: graphify-out lines, [STACK HEALTH]/[PLANS HEALTH]/hook: stack-health/hook: plans-health output, and <supermemory-recall>/<supermemory-context> blocks entirely; they are re-injected live by hooks and only compound noise across compaction cycles.",
  "effortLevel": "high",
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "autoresearch@autoresearch": false,
    "bash-language-server@claude-code-lsps": false,
    "gopls-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true
  },
  "env": {
    "AR_DISABLE_SIMPLIFY_GATE": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "HEADROOM_CONTEXT_TOOL": "lean-ctx",
    "USE_BUILTIN_RIPGREP": "0",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "auto",
    "HEADROOM_DISABLE_KOMPRESS": "1",
    "HEADROOM_EXCLUDE_TOOLS": "bash,codebase_search,ctx_call,ctx_compose,ctx_expand,ctx_glob,ctx_read,ctx_search,ctx_session,ctx_shell,ctx_tree,exec_command,glob,grep,grep_search,list_directory,list_files,listdirectory,listfiles,mcp__lean-ctx__ctx_call,mcp__lean-ctx__ctx_compose,mcp__lean-ctx__ctx_expand,mcp__lean-ctx__ctx_glob,mcp__lean-ctx__ctx_read,mcp__lean-ctx__ctx_search,mcp__lean-ctx__ctx_session,mcp__lean-ctx__ctx_shell,mcp__lean-ctx__ctx_tree,mcp__lean-ctx__shell,mcp__lean_ctx__ctx_call,mcp__lean_ctx__ctx_compose,mcp__lean_ctx__ctx_expand,mcp__lean_ctx__ctx_glob,mcp__lean_ctx__ctx_read,mcp__lean_ctx__ctx_search,mcp__lean_ctx__ctx_session,mcp__lean_ctx__ctx_shell,mcp__lean_ctx__ctx_tree,mcp__lean_ctx__shell,mcp__pctx__execute_typescript,mcp__pctx__get_function_details,mcp__pctx__list_functions,read,read_file,read_many_files,read_text_file,readfile,run_command,run_shell_command,search,search_file_content,search_files,semantic_search,shell,shell_command,view,view_file",
    "HEADROOM_NO_SUBSCRIPTION_TRACKING": "1"
  },
  "extraKnownMarketplaces": {
    "autoresearch": {
      "source": {
        "source": "git",
        "url": "https://github.com/uditgoenka/autoresearch.git"
      }
    }
  },
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/config-integrity.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*_settings"
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/instructions-loaded.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/context-monitor.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/post-tool-analytics.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/prompt-score-commit.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/teammate-quality-gate.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "command": "bash -lc '\"$HOME/.dotfiles/.local/bin/lean_ctx_wrapper.sh\" hook read-dedup'",
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/lean-ctx-observe.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/pre-compact.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/lean-ctx-observe.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/pre-tool-gate-v2.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep|Glob|Agent"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/graphify-redirect.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Grep|Glob"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/scratchpad-reread-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/chrome-mcp-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "mcp__claude-in-chrome__.*"
      },
      {
        "matcher": "Bash|bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/lean-ctx-rewrite.sh\""
          }
        ]
      },
      {
        "matcher": "Read|read|ReadFile|read_file|View|view|Grep|grep|Search|search|ListFiles|list_files|ListDirectory|list_directory|Glob|glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/lean-ctx-redirect.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/lean-ctx-observe.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/sessionstart.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/lean-ctx-observe.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/stop.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/lean-ctx-observe.sh\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/task-event-tracker.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/task-event-tracker.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/userpromptsubmit.sh\"",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/lean-ctx-observe.sh\""
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/worktree-create.sh\"",
            "type": "command"
          },
          {
            "command": "bash \"$HOME/.dotfiles/tmux/scripts/claude-tmux-bridge.sh\" worktree-enter",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.dotfiles/.claude/hooks/worktree-remove.sh\"",
            "type": "command"
          },
          {
            "command": "bash \"$HOME/.dotfiles/tmux/scripts/claude-tmux-bridge.sh\" worktree-exit",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "Skill(*)",
      "ToolSearch(*)",
      "AskUserQuestion(*)",
      "EnterPlanMode(*)",
      "ExitPlanMode(*)",
      "EnterWorktree(*)",
      "ExitWorktree(*)",
      "NotebookEdit(*)",
      "CronCreate(*)",
      "CronDelete(*)",
      "CronList(*)",
      "RemoteTrigger(*)",
      "TaskCreate(*)",
      "TaskGet(*)",
      "TaskList(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "TaskUpdate(*)",
      "mcp__pctx__*",
      "mcp__graphify__*",
      "mcp__notebooklm__*",
      "mcp__exa__*",
      "mcp__qmd__*",
      "mcp__repomix__*",
      "mcp__lean-ctx__ctx_read",
      "mcp__lean-ctx__ctx_search",
      "mcp__lean-ctx__ctx_tree",
      "mcp__lean-ctx__ctx_overview",
      "mcp__lean-ctx__ctx_plan",
      "mcp__lean-ctx__ctx_metrics",
      "mcp__lean-ctx__ctx_compress",
      "mcp__lean-ctx__ctx_session",
      "mcp__lean-ctx__ctx_knowledge",
      "mcp__lean-ctx__ctx_graph",
      "mcp__lean-ctx__ctx_retrieve",
      "mcp__lean-ctx__ctx_provider"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * -O- | sh)",
      "Bash(wget * | bash)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -fd*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(kill -9 *)",
      "Bash(find * -delete*)",
      "Bash(find *)",
      "Bash(shred *)",
      "Bash(dd if=*)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Read(~/.ssh/*)",
      "Edit(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Edit(~/.aws/*)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(grep -*)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/Cargo.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/composer.lock)",
      "Read(**/Gemfile.lock)",
      "Read",
      "Grep",
      "Glob"
    ]
  },
  "plansDirectory": "./plans",
  "preferredNotifChannel": "ghostty",
  "skillOverrides": {
    "ado-workitem": "off",
    "ai-usage-analyst": "off",
